# Copy to .env and adjust as needed. docker-compose already sets these for you;
# this file is for running the backend standalone against your own MySQL.

DATABASE_URL=mysql+pymysql://scheduler:scheduler@localhost:3306/placement_scheduler
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

NUM_DAYS=4
DAY_START_MIN=540
DAY_END_MIN=1080
SLOT_GRANULARITY_MIN=5
NUM_ROOMS=20
NUM_STUDENTS=800
NUM_COMPANIES=35
MAX_SPILLOVER_MIN=60
RANDOM_SEED=42
